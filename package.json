{
  "name": "collabdocs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,socket -c cyan,magenta \"npm run dev:web\" \"npm run dev:socket\"",
    "dev:web": "next dev",
    "dev:socket": "tsx watch --env-file=.env.local server/index.ts",
    "build": "next build",
    "start": "next start",
    "start:socket": "tsx server/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/extension-collaboration": "^3.30.0",
    "@tiptap/extension-collaboration-caret": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "mongoose": "^9.9.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.12",
    "uuid": "^14.0.1",
    "y-protocols": "^1.0.7",
    "y-socket.io": "^1.1.3",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
